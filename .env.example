# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (automatically provisioned in AI Studio)
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# Supabase Authentication & File Storage Configuration (Project: CHC Muribahal)
# Project URL is pre-connected to wlxkanjneaxpnnlkpnqc; add ANON and SERVICE_ROLE keys in AI Studio Secrets
SUPABASE_URL="https://wlxkanjneaxpnnlkpnqc.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Optional client-prefixed mirrors (auto-loaded from server /api/config/supabase if omitted)
VITE_SUPABASE_URL="https://wlxkanjneaxpnnlkpnqc.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Supabase Storage Buckets
SUPABASE_STORAGE_DOCTOR_BUCKET="doctor-photos"
SUPABASE_STORAGE_DOCUMENTS_BUCKET="patient-documents"

# Cloud SQL PostgreSQL connection variables (injected automatically by AI Studio)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional: Authorized initial admin email(s), comma-separated (defaults to app owner email)
HOSPITAL_ADMIN_EMAILS=""

# Optional: SMS Provider credentials (e.g., Twilio / MSG91 / Fast2SMS) for live SMS notifications
SMS_PROVIDER_URL=""
SMS_PROVIDER_API_KEY=""
SMS_SENDER_ID="CHCMRB"
